{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Middle-aged and older audience video narration package contract",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "strategy",
    "segments",
    "claims",
    "evidence",
    "titles",
    "delivery"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "project": {
      "type": "object",
      "required": [
        "name",
        "domain",
        "project_type",
        "topic",
        "audience",
        "duration_seconds"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "domain": {
          "enum": [
            "history_culture",
            "geography_travel",
            "life_skill"
          ]
        },
        "project_type": {"enum": ["single", "series"]},
        "topic": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "minimum": 15},
        "tone": {"type": "string"},
        "platform": {"type": "string"},
        "series": {
          "type": "object",
          "required": [
            "series_title",
            "episode_number",
            "total_episodes",
            "episode_title",
            "arc_role"
          ],
          "properties": {
            "series_title": {"type": "string", "minLength": 1},
            "episode_number": {"type": "integer", "minimum": 1},
            "total_episodes": {"type": "integer", "minimum": 1},
            "episode_title": {"type": "string", "minLength": 1},
            "arc_role": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "core_theme",
        "opening_angle",
        "closing_idea",
        "content_roles",
        "audience_adaptations",
        "tone_markers"
      ],
      "properties": {
        "core_theme": {"type": "string", "minLength": 1},
        "opening_angle": {"type": "string", "minLength": 1},
        "closing_idea": {"type": "string", "minLength": 1},
        "content_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1}
            }
          }
        },
        "audience_adaptations": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "tone_markers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 2}
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "start_seconds",
          "end_seconds",
          "text"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,7}$"},
          "title": {"type": "string", "minLength": 1},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "text": {"type": "string", "minLength": 1},
          "claim_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "reading_notes": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "segment_ids",
          "evidence_ids",
          "risk_level",
          "category",
          "verification_status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]+$"},
          "statement": {"type": "string", "minLength": 1},
          "segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "risk_level": {"enum": ["low", "medium", "high"]},
          "category": {
            "enum": [
              "historical",
              "cultural",
              "geographic",
              "scientific",
              "life_practice",
              "safety",
              "medical",
              "legal",
              "other"
            ]
          },
          "verification_status": {
            "enum": ["verified", "unverified", "disputed"]
          },
          "notes": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_type",
          "source_title",
          "publisher",
          "accessed_date",
          "reliability",
          "status",
          "supports"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "source_type": {
            "enum": [
              "official",
              "academic",
              "primary",
              "professional",
              "authoritative_media",
              "user_material"
            ]
          },
          "source_title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "author": {"type": "string"},
          "url_or_identifier": {"type": "string"},
          "published_date": {"type": "string"},
          "accessed_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "reliability": {"enum": ["high", "medium", "low"]},
          "status": {
            "enum": ["verified", "partial", "unverified", "disputed"]
          },
          "supports": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "titles": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "delivery": {
      "type": "object",
      "required": ["version", "date"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "notes": {"type": "string"}
      }
    }
  }
}
