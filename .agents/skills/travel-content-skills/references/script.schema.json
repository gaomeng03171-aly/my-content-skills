{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel video script contract",
  "type": "object",
  "required": ["schema_version", "project", "strategy", "narration", "titles", "delivery"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "required": ["name", "locations", "tone", "duration_seconds"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "tone": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "minimum": 15},
        "platform": {"type": "string"},
        "audience": {"type": "string"}
      }
    },
    "strategy": {
      "type": "object",
      "required": ["core_theme", "opening_angle", "closing_idea", "location_roles", "tone_markers"],
      "properties": {
        "core_theme": {"type": "string", "minLength": 1},
        "opening_angle": {"type": "string", "minLength": 1},
        "closing_idea": {"type": "string", "minLength": 1},
        "location_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["location", "role"],
            "properties": {
              "location": {"type": "string"},
              "role": {"type": "string"}
            }
          }
        },
        "tone_markers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 2}
        }
      }
    },
    "narration": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "locations", "target_seconds", "text"],
            "properties": {
              "name": {"type": "string"},
              "locations": {
                "type": "array",
                "items": {"type": "string"}
              },
              "target_seconds": {"type": "number", "exclusiveMinimum": 0},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "titles": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "delivery": {
      "type": "object",
      "required": ["version", "date"],
      "properties": {
        "version": {"type": "string"},
        "date": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
